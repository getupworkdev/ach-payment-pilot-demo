# Copy to supabase/functions/.env for `supabase functions serve --env-file`.
PROVIDER_WEBHOOK_SECRET=whsec_local_demo_only
# The edge runtime runs in Docker; this reaches the mock services on the host.
MOCK_SERVICES_URL=http://host.docker.internal:54400
POS_TIMEOUT_MS=3000
RECONCILE_STALE_SUBMITTED_SECONDS=120
# One set of provider client credentials per entity (demo values for the mock).
# In production: one Supabase Vault secret per entity.
PROVIDER_ENTITY_CREDENTIALS={"store-001":{"client_id":"client-store-001","client_secret":"secret-store-001"},"store-002":{"client_id":"client-store-002","client_secret":"secret-store-002"}}
PROVIDER_TIMEOUT_MS=5000
