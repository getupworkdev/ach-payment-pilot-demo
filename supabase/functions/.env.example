# Copy to supabase/functions/.env for `supabase functions serve --env-file`.
PROVIDER_WEBHOOK_SECRET=whsec_local_demo_only
# The edge runtime runs in Docker; this reaches the mock services on the host.
MOCK_SERVICES_URL=http://host.docker.internal:54400
POS_TIMEOUT_MS=3000
RECONCILE_STALE_SUBMITTED_SECONDS=120
