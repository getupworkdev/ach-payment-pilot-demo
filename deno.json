{
  "tasks": {
    "test": "deno test --allow-read --allow-env --allow-net tests/",
    "check": "deno check supabase/functions/*/index.ts scripts/*.ts tests/*.ts",
    "mock": "deno run --allow-net --allow-env scripts/mock_services.ts",
    "serve": "deno run --allow-net --allow-env --allow-read scripts/serve_local.ts",
    "demo": "deno run --allow-net --allow-env scripts/demo.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.3.0"
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "README.md"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "require-await",
        "no-import-prefix"
      ]
    }
  }
}
